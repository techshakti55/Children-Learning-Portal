          "correctOptionId": "D",
          "hint": "Look to the left of zero on the number line.",
          "explanation": "-3 is a negative integer. Whole numbers do not include negative numbers.",
          "mathCheck": {
            "kind": "integer-not-whole",
            "candidates": [
              0,
              4,
              0.5,
              -3
            ]
          }
        },
        {
          "id": "nt-l4-q02",
