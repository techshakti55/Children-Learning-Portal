    {
      "id": "nt-l2",
      "order": 2,
      "title": "Pair Up",
      "optional": false,
      "objectives": [
        "Identify even and odd whole numbers.",
        "Explain why zero is even."
      ],
      "prerequisites": [
        "nt-l1",
        "Count in groups of two."
      ],
      "explanationBlocks": [
        "An even whole number can be split into pairs with nothing left over. An odd whole number leaves one object without a partner.",
        "Even numbers end in 0, 2, 4, 6 or 8. Odd numbers end in 1, 3, 5, 7 or 9.",
        "Zero is even: zero objects make zero pairs, with nothing left over. Also, 0 = 2 × 0. A whole number is either even or odd; it cannot be both."
      ],
      "examples": [
        {
          "id": "nt-l2-ex1",
          "prompt": "Are 8 socks even or odd?",
          "steps": [
            "Make pairs: 2 + 2 + 2 + 2 = 8.",
            "There are 4 pairs and no sock is left."
          ],
          "answer": "8 is even."
        },
        {
          "id": "nt-l2-ex2",
          "prompt": "Are 7 counters even or odd?",
          "steps": [
            "Make 3 pairs: 2 + 2 + 2 = 6.",
            "One counter is left without a partner."
          ],
          "answer": "7 is odd."
        }
      ],
