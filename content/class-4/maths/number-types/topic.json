  "lessons": [
    {
      "id": "nt-l1",
      "order": 1,
      "title": "Counting World",
      "optional": false,
      "objectives": [
        "Recognise natural and whole numbers.",
        "Explain where zero belongs."
      ],
      "prerequisites": [
        "Count objects from 1."
      ],
      "explanationBlocks": [
        "We use natural numbers to count: 1, 2, 3, 4, and so on. In this portal, natural numbers start at 1.",
        "Whole numbers are 0, 1, 2, 3, and so on. Zero tells us there are no objects.",
        "A number can belong to more than one family. Every natural number is also a whole number. Zero is whole but is not natural. Neither family has a greatest number."
      ],
      "examples": [
        {
          "id": "nt-l1-ex1",
          "prompt": "An empty basket has no apples. Which number shows this?",
          "steps": [
            "Count the apples: there are none.",
            "Use 0 to show no apples.",
            "0 is a whole number. It is not a natural number here."
          ],
          "answer": "0"
        },
        {
          "id": "nt-l1-ex2",
          "prompt": "Which families contain 7?",
          "steps": [
            "7 is a counting number, so it is natural.",
            "Whole numbers include every natural number."
          ],
          "answer": "7 is both natural and whole."
        }
      ],
      "practice": [
